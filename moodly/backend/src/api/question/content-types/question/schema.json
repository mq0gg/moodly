{
  "kind": "collectionType",
  "collectionName": "questions",
  "info": {
    "singularName": "question",
    "pluralName": "questions",
    "displayName": "Question",
    "description": "One SipSense quiz question, editable without redeploy. ADR-002, FR-05, FR-06."
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "text": {
      "type": "string",
      "required": true
    },
    "order": {
      "type": "integer",
      "required": true,
      "unique": true
    },
    "selectionMode": {
      "type": "enumeration",
      "enum": ["single", "multiple"],
      "default": "single",
      "required": true
    },
    "isActive": {
      "type": "boolean",
      "default": true,
      "required": true
    },
    "answers": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::answer.answer",
      "mappedBy": "question"
    }
  }
}
