# Copy to .env and fill in real values. Never commit .env (NFR-07: no secrets in the repo).

# --- Database (NFR-05) ---
DATABASE_NAME=moodly
DATABASE_USERNAME=moodly
DATABASE_PASSWORD=moodly
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_SSL=false

# --- Strapi secrets ---
# Generate each with: node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
APP_KEYS=changeme1,changeme2,changeme3,changeme4
API_TOKEN_SALT=changeme
ADMIN_JWT_SECRET=changeme
TRANSFER_TOKEN_SALT=changeme
ENCRYPTION_KEY=changeme
JWT_SECRET=changeme

# --- URLs ---
PUBLIC_URL=http://localhost:1337
FRONTEND_URL=http://localhost:5173

# --- Email notifications (owner alerts on suggestions/comments — B-20) ---
EMAIL_PROVIDER=sendmail
EMAIL_FROM=no-reply@moodly.local
OWNER_EMAIL=you@example.com
